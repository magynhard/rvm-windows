{
  "name": "rvm-windows",
  "version": "1.1.4-develop.1",
  "description": "Ruby Version Manager for Windows — native installer bridge",
  "author": "Matthäus J. N. Beyrle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magynhard/rvm-windows.git"
  },
  "homepage": "https://github.com/magynhard/rvm-windows#readme",
  "bugs": {
    "url": "https://github.com/magynhard/rvm-windows/issues"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "rvmWindowsBridge": 1,
  "publishConfig": {
    "tag": "develop"
  },
  "bin": {
    "rvm": "rvm.cmd"
  },
  "scripts": {
