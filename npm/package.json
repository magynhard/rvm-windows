  },
  "files": [
    "rvm.cmd",
    "install.ps1",
    "rvm-windows-setup.exe",
    "src/tools/current"
  ],
  "keywords": [
    "ruby",
    "rvm",
    "windows",
    "version-manager",
    "crystal"
  ]
